    <div id="entryheader">
        <h1><a href="/">The Baseball Chronicle</a></h1>
        <h2><span class="entryprev"><a href="http://thebaseballchronicle.com/personal_stories/pujols_through_the_ages" title="Previous story">&#8592;</a></span> <a href="http://thebaseballchronicle.com/personal_stories/">Personal stories</a>, September 2009 <span class="entrynext"><a href="http://thebaseballchronicle.com/personal_stories/close_to_heaven" title="Next story">&#8594;</a></span</h2>

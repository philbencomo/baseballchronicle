    <div id="entryheader">
        <h1><a href="/">The Baseball Chronicle</a></h1>
        <h2><span class="entryprev"><a href="http://thebaseballchronicle.com/fiction/strike_zone" title="Previous story">&#8592;</a></span> <a href="http://thebaseballchronicle.com/personal_stories/">Personal stories</a>, November 2010 <span class="entrynext"><a href="http://thebaseballchronicle.com/poetry/the_first_practice" title="Next story">&#8594;</a></span</h2>

			<div class="headlinetext">
				<h1>Take Me Out</h1>
				<h3 class="byline">By Rachel Van Sickle</h3>
			</div>
		</div>
		
		<div class="textwrapper">
			<script src="/scripts/read-along.js"></script>
			<script src="/scripts/main.js"></script>
			<script src="/scripts/waypoints.min.js"></script>
			
